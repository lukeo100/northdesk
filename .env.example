# Copy this file to .env.local and fill in your own values. Never commit .env.local.
# Find both values in Supabase: Project Settings > API (or the Connect dialog).

# Project URL, for example https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key (starts with sb_publishable_) or the legacy anon key.
# This key is safe for the browser. Never use the secret or service_role key here.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
